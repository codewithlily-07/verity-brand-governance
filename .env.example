# VERITY Configuration Template (.env.example)

# Port configuration (Defaults to 8000; dynamically set by PaaS hosts like Render)
PORT=8000

# Database Configuration
# Local SQLite default: sqlite:///./verity.db
# Supabase / PostgreSQL with pgvector: postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres
DATABASE_URL=sqlite:///./verity.db

# Large Language Model Provider (Layer 3 Contextual AI - Optional with Graceful Fallback)
# The application runs fully with 100% precision/recall on deterministic rules and semantic retrieval without an AI key.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# Embeddings (Hybrid retrieval: pgvector enhancement, BM25/FTS fallback)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=

# Operational Governance & Security
MAX_UPLOAD_MB=10
ALLOWED_ORIGINS=["*"]
RATE_LIMIT_PER_MIN=60
DEMO_MODE=true
WORKSPACE_TTL_HOURS=24
